<?php

namespace App\Modules\{{module}}\{{entity}}\Actions;

use Illuminate\Support\Facades\DB;
use {{modelClass}};
use App\Modules\{{module}}\{{entity}}\DTOs\Delete{{entity}}DTO;

class Delete{{entity}}Action
{
    public function __invoke(
        Delete{{entity}}DTO $dto
    ): bool {

        return DB::transaction(
            function () use ($dto) {

                $model = {{modelBaseName}}::findOrFail(
                    $dto->id
                );

                /*
                |--------------------------------------------------------------------------
                | Future business rules
                |--------------------------------------------------------------------------
                */

                /*
                |--------------------------------------------------------------------------
                | Future hooks
                |--------------------------------------------------------------------------
                */

                // app({{entity}}Service::class)
                //     ->beforeDelete($model);

                return (bool) $model->delete();
            }
        );
    }
}